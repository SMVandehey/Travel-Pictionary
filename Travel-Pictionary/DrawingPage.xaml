<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:drawing="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Travel_Pictionary.DrawingPage"
             Title="Draw">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto">
        <Label x:Name="TimerLabel" Grid.Row="0" FontSize="24" HorizontalTextAlignment="End" />
        <drawing:DrawingView x:Name="DrawingCanvas" Grid.Row="1" HeightRequest="420" />
        <VerticalStackLayout x:Name="GuessButtons" Grid.Row="2" Spacing="8" />
    </Grid>
</ContentPage>
