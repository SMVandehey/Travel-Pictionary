<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Travel_Pictionary.SummaryPage"
             Title="Summary">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Game Summary" FontSize="32" HorizontalTextAlignment="Center" />
            <VerticalStackLayout x:Name="ScoresLayout" Spacing="8" />
            <Label x:Name="WinnerLabel" FontSize="26" HorizontalTextAlignment="Center" />
            <Button Text="NEW GAME" Clicked="OnNewGameClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
